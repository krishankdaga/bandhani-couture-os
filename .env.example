# Homebrew PostgreSQL commonly uses your macOS username and trusted local auth.
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/cbos?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
# Optional. Required only for the owner-only Bandhani Assistant.
GROQ_API_KEY=""
# Optional model override.
GROQ_MODEL="llama-3.1-8b-instant"
